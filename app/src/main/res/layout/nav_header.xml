<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="170dp"
    android:background="@drawable/bg_splash_gradient"
    android:gravity="bottom"
    android:orientation="vertical"
    android:padding="20dp"
    android:theme="@style/ThemeOverlay.AppCompat.Dark">

    <ImageView
        android:id="@+id/ivHeaderAvatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="Avatar"
        android:src="@drawable/ic_logo" />

    <TextView
        android:id="@+id/tvHeaderName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Juan Pablo Acevedo"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvHeaderEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="jpabloacevedo@ucompensar.edu.co"
        android:textColor="@color/textMuted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvHeaderRole"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/role_badge_bg"
        android:text="ROL: COMPRADOR"
        android:textColor="@color/roleBuyer"
        android:textSize="10sp"
        android:textStyle="bold" />

</LinearLayout>
